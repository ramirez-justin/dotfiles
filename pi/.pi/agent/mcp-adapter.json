{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "lifecycle": "lazy",
      "directTools": true
    },
    "sofia-cloud": {
      "url": "https://avgjtkgppeeihntsyjpy.supabase.co/functions/v1/sofia-core",
      "headers": {
        "x-sofia-key": "${SOFIA_MCP_ACCESS_KEY}"
      },
      "auth": false,
      "lifecycle": "lazy"
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "auth": "oauth",
      "lifecycle": "lazy"
    },
    "google-docs": {
      "command": "op",
      "args": [
        "run",
        "--no-masking",
        "--",
        "uvx",
        "workspace-mcp@2.1.0",
        "--single-user",
        "--permissions",
        "docs:full",
        "sheets:full",
        "drive:readonly"
      ],
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "op://dev_vault/s3546ldcf62uuc4kmr5jn5nsna/add more/Client ID",
        "GOOGLE_OAUTH_CLIENT_SECRET": "op://dev_vault/s3546ldcf62uuc4kmr5jn5nsna/add more/Client secret"
      },
      "lifecycle": "lazy"
    },
    "playwright-airbnb": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser",
        "chrome",
        "--user-data-dir",
        "/Users/justinramirez/Library/Application Support/pi-browser/airbnb",
        "--output-dir",
        "/Users/justinramirez/Library/Caches/pi-browser/airbnb"
      ],
      "lifecycle": "lazy"
    },
    "pricelabs": {
      "url": "https://mcp.pricelabs.co/mcp",
      "auth": "oauth",
      "oauth": {
        "clientId": "cVhTRTkM7-0KeA81IBbsdYKTphYxrP0TNfk2hRzlTsM",
        "clientSecret": "!op read 'op://930 Brookdale/PriceLabs MCP/Client Secret'",
        "redirectUri": "http://localhost:3118/callback"
      },
      "lifecycle": "lazy"
    }
  }
}
