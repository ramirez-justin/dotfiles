#!/usr/bin/env bash
# sofia — SOFIA-backed Hermes CLI.
# Use `sofia-local` for the legacy local SOFIA second-brain CLI.
set -euo pipefail

wrapper="${HERMES_SOFIA_WRAPPER:-$HOME/.hermes/profiles/sofia-spike/scripts/hermes-sofia}"

if [[ ! -x "$wrapper" ]]; then
  echo "sofia: Hermes SOFIA wrapper is missing or not executable: $wrapper" >&2
  echo "Run: cd ~/dev/dotfiles && mise run hermes:sofia:link" >&2
  exit 1
fi

exec "$wrapper" "$@"
