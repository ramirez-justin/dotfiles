{
  "settings": {
    "autoAuth": true
  },
  "mcpServers": {
    "context7": {
      "command": "sh",
      "args": [
        "-lc",
        "CONTEXT7_API_KEY=$(op read 'op://Employee/Context7 Secret Key/API Key') exec npx -y @upstash/context7-mcp"
      ],
      "lifecycle": "lazy",
      "directTools": true
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "auth": "oauth",
      "lifecycle": "lazy"
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "auth": "oauth",
      "lifecycle": "lazy"
    },
    "gmail": {
      "url": "https://gmailmcp.googleapis.com/mcp/v1",
      "auth": "oauth",
      "lifecycle": "lazy"
    },
    "chalk": {
      "command": "sh",
      "args": [
        "-lc",
        "exec \"$HOME/.pi/agent/bin/chalk-mcp\""
      ],
      "lifecycle": "lazy"
    },
    "jira": {
      "command": "sh",
      "args": ["-lc", "exec \"$HOME/.pi/agent/bin/jira-mcp\""],
      "env": {
        "JIRA_URL": "https://gametime.atlassian.net",
        "JIRA_USERNAME": "justin.ramirez@gametime.co",
        "TOOLSETS": "all"
      },
      "lifecycle": "lazy"
    }
  }
}
