{
  "settings": {
    "autoAuth": true,
    "namespaceProxyTools": false
  },
  "mcpServers": {
    "context7": {
      "command": "sh",
      "args": [
        "-lc",
        "CONTEXT7_API_KEY=$(op read 'op://Employee/Context7 Secret Key/API Key') exec npx -y @upstash/context7-mcp"
      ],
      "lifecycle": "lazy",
      "directTools": "search"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "auth": "oauth",
      "lifecycle": "lazy",
      "approveTools": [
        "prepare_*",
        "create_*",
        "save_*",
        "delete_*",
        "retire_*",
        "restore_*",
        "share_*",
        "unshare_*",
        "mark_*",
        "resolve_*",
        "submit_*",
        "update_*",
        "merge_*"
      ]
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "auth": "oauth",
      "lifecycle": "lazy",
      "approveTools": [
        "notion-create-*",
        "notion-update-*",
        "notion-delete-*",
        "notion-restore-*",
        "notion-convert-*",
        "notion-upload-*",
        "notion-complete-*",
        "notion-move-*",
        "notion-duplicate-*",
        "notion-set-*",
        "notion-resolve-*",
        "notion-spawn-*",
        "notion-stop-*",
        "notion-send-*",
        "notion-calendar-create-*",
        "notion-calendar-update-*",
        "notion-calendar-cancel-*",
        "notion-link-*"
      ]
    },
    "gmail": {
      "url": "https://gmailmcp.googleapis.com/mcp/v1",
      "auth": "oauth",
      "lifecycle": "lazy"
    },
    "chalk": {
      "command": "sh",
      "args": [
        "-lc",
        "exec \"$HOME/.pi/agent/bin/chalk-mcp\""
      ],
      "lifecycle": "lazy"
    },
    "jira": {
      "command": "sh",
      "args": ["-lc", "exec \"$HOME/.pi/agent/bin/jira-mcp\""],
      "env": {
        "JIRA_URL": "https://gametime.atlassian.net",
        "JIRA_USERNAME": "justin.ramirez@gametime.co",
        "TOOLSETS": "all"
      },
      "lifecycle": "lazy"
    }
  }
}
