{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "lifecycle": "lazy",
      "directTools": true
    },
    "sofia-cloud": {
      "url": "https://avgjtkgppeeihntsyjpy.supabase.co/functions/v1/sofia-core",
      "headers": {
        "x-sofia-key": "${SOFIA_MCP_ACCESS_KEY}"
      },
      "auth": false,
      "lifecycle": "lazy"
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "auth": "oauth",
      "lifecycle": "lazy"
    },
    "google-docs": {
      "command": "op",
      "args": ["run", "--no-masking", "--", "uvx", "workspace-mcp@2.1.0", "--single-user", "--permissions", "docs:full"],
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "op://dev_vault/s3546ldcf62uuc4kmr5jn5nsna/add more/Client ID",
        "GOOGLE_OAUTH_CLIENT_SECRET": "op://dev_vault/s3546ldcf62uuc4kmr5jn5nsna/add more/Client secret"
      },
      "lifecycle": "lazy"
    }
  }
}
